meta {
  name: 04 Utilizador da service account
  type: http
  seq: 4
}

get {
  url: {{keycloak}}/admin/realms/{{realm}}/users?username=service-account-{{clientId}}&exact=true
  body: none
  auth: bearer
}

params:query {
  username: service-account-{{clientId}}
  exact: true
}

auth:bearer {
  token: {{adminToken}}
}

vars:post-response {
  saUserId: res.body[0].id
}

assert {
  res.status: eq 200
  res.body: length 1
}
