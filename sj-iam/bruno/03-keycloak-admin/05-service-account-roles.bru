meta {
  name: 05 Roles da service account
  type: http
  seq: 5
}

get {
  url: {{keycloak}}/admin/realms/{{realm}}/users/{{saUserId}}/role-mappings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("service account tem manage-users, query-users e view-users", function () {
    const names = res.body.clientMappings["realm-management"].mappings.map(m => m.name);
    expect(names).to.include.members(["manage-users", "query-users", "view-users"]);
  });
}
